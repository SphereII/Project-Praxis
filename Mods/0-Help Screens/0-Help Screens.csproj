<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
	<Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props" Condition="Exists('$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props')"/>
	<PropertyGroup>
		<Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
		<Platform Condition=" '$(Platform)' == '' ">AnyCPU</Platform>
		<ProjectGuid>{34E5C4FB-5298-4879-AF1B-0DD3BB7B193F}</ProjectGuid>
		<OutputType>Library</OutputType>
		<AppDesignerFolder>Properties</AppDesignerFolder>
		<RootNamespace>SphereII.HelpScreens</RootNamespace>
		<AssemblyName>SphereIIHelpScreens</AssemblyName>
		<TargetFrameworkVersion>v4.8.1</TargetFrameworkVersion>
		<FileAlignment>512</FileAlignment>
		<RunPostBuildEvent>Always</RunPostBuildEvent>
		<Deterministic>true</Deterministic>
	</PropertyGroup>
	<PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
		<PlatformTarget>AnyCPU</PlatformTarget>
		<DebugSymbols>true</DebugSymbols>
		<DebugType>full</DebugType>
		<Optimize>false</Optimize>
		<OutputPath>.\</OutputPath>
		<DefineConstants>DEBUG;TRACE</DefineConstants>
		<ErrorReport>prompt</ErrorReport>
		<WarningLevel>4</WarningLevel>
	</PropertyGroup>
	<PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
		<PlatformTarget>AnyCPU</PlatformTarget>
		<DebugType>pdbonly</DebugType>
		<Optimize>true</Optimize>
		<OutputPath>bin\Release\</OutputPath>
		<DefineConstants>TRACE</DefineConstants>
		<ErrorReport>prompt</ErrorReport>
		<WarningLevel>4</WarningLevel>
	</PropertyGroup>

	<ItemGroup>
		<Reference Include="0Harmony">
			<HintPath>..\0_TFP_Harmony\0Harmony.dll</HintPath>
			<Private>False</Private>
		</Reference>
		<Reference Include="Assembly-CSharp">
			<HintPath>..\..\7DaysToDie_Data\Managed\Assembly-CSharp.dll</HintPath>
			<Private>False</Private>
		</Reference>
		<Reference Include="LogLibrary">
			<HintPath>..\..\7DaysToDie_Data\Managed\LogLibrary.dll</HintPath>
			<Private>False</Private>
		</Reference>
		<Reference Include="UnityEngine.CoreModule">
			<HintPath>..\..\7DaysToDie_Data\Managed\UnityEngine.CoreModule.dll</HintPath>
			<Private>False</Private>
		</Reference>
		<Reference Include="System"/>
		<Reference Include="System.Core"/>
		<Reference Include="System.Data"/>
		<Reference Include="System.Xml"/>
	</ItemGroup>

	<!--
		The only code here is the ESC-menu button wiring, which XML genuinely cannot do -
		XUiC_InGameMenuWindow.Init hard-wires its ten buttons by name and attaches C#
		handlers, so an appended button would otherwise be inert. Everything else about
		the help screen is XML.

		The T4 below stamps Properties/AssemblyInfo.cs and the post-build sed copies that
		version into ModInfo.xml. Add each new Config file here as it is created.
	-->
	<ItemGroup>
		<Content Include="Config\Localization.csv"/>
		<Content Include="Config\XUi_InGame\templates.xml"/>
		<Content Include="Config\XUi_InGame\windows.xml"/>
		<Content Include="Config\XUi_InGame\xui.xml"/>
		<Content Include="Config\XUi_Menu\templates.xml" />
		<Content Include="Config\XUi_Menu\windows.xml" />
		<Content Include="Config\XUi_Menu\xui.xml" />
		<Content Include="ModInfo.xml"/>
		<Content Include="ReadMe.md"/>
		<Content Include="Properties\AssemblyInfo.tt">
			<Generator>TextTemplatingFileGenerator</Generator>
			<LastGenOutput>AssemblyInfo.cs</LastGenOutput>
		</Content>
	</ItemGroup>
	<ItemGroup>
		<Compile Include="Init.cs"/>
		<Compile Include="Harmony\XUiC_InGameMenuWindow_HelpButton.cs"/>
		<Compile Include="Scripts\XUiC_HelpScreens.cs"/>
		<Compile Include="Properties\AssemblyInfo.cs">
			<AutoGen>True</AutoGen>
			<DesignTime>True</DesignTime>
			<DependentUpon>AssemblyInfo.tt</DependentUpon>
		</Compile>
	</ItemGroup>
	<Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
	<Import Project="$(SolutionDir)\Tools\Directory.Build.targets" Condition="Exists('$(SolutionDir)\Tools\Directory.Build.targets')" />
	<PropertyGroup>
		<PreBuildEvent>
		</PreBuildEvent>
	</PropertyGroup>
	<PropertyGroup>
		<PostBuildEvent>

			:: Update the ModInfo.xml
			IF EXIST "$(ProjectDir)ModInfo.xml" (
				IF EXIST "$(ProjectDir)..\Tools\bin\sed.exe" (
					:: Sort out the version number from the Configuration, and grab the last digits of the Version number
					echo Updating Version number to @(VersionNumber)
					"$(ProjectDir)..\Tools\bin\sed.exe" -i "s/Version value=\"*.*.*.*\"/Version value=\"@(VersionNumber)\"/g" "$(ProjectDir)ModInfo.xml"
				)
			)
		</PostBuildEvent>
	</PropertyGroup>
</Project>
